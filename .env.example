# 复制成 .env 后填写。.env 已被 .gitignore 排除，不会进仓库。
#
#   cp .env.example .env
#
# 只有跑 `npm run game -- --llm` 才需要 key。
# 规则 bot（默认）和假 LLM（--fake）都不联网，不需要任何配置。

# 用哪个模型服务：anthropic | deepseek | claude-cli
#   claude-cli = 用本机已登录的 claude 命令行，不需要任何 key。
#                慢（约 25s 一次调用），适合验证，不适合跑批
LLM_PROVIDER=anthropic

# ---- Anthropic ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 可选，默认 claude-opus-5
ANTHROPIC_MODEL=claude-opus-5

# ---- DeepSeek ----
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# deepseek-chat（V3，快）或 deepseek-reasoner（R1，会推理但慢且贵）
DEEPSEEK_MODEL=deepseek-chat
# 可选，默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=

# 思考深度：low | medium | high | xhigh | max（仅 Anthropic 有效）
LLM_EFFORT=medium


# =============================================================
# 数据库（Neon / Postgres）
#
# ⚠️ 这一段的变量**绝对不能加 VITE_ 前缀**。
#    Vite 只把 VITE_ 开头的变量注入前端，其余留在服务端 ——
#    给连接串加上 VITE_ 等于把数据库密码打进 JS 包发给每个访客，
#    而且这个错误不会有任何报错提示。
#
#    同理：浏览器永远不直连数据库。所有读写都要经过服务端。
# =============================================================

# Neon 控制台 → 你的项目 → Connection Details → Connection string
# 形如 postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# 迁移/建表用的直连串（Neon 的 pooled 连接不支持某些 DDL）。
# 控制台里把 "Pooled connection" 关掉再复制一次即可；不填则回退到 DATABASE_URL
DATABASE_URL_UNPOOLED=

# 建在哪个 schema 下，方便同一个库里区分环境
DB_SCHEMA=dolos
